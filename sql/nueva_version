-- =========================================================================
-- 5. VISTAS ADAPTADAS AL MODELO UNIFICADO Y CON NUEVOS NOMBRES
-- =========================================================================

CREATE OR ALTER VIEW [ofertas].[vw_listado_ofertas_interacciones]
AS
SELECT
	lo.id_oferta,
	e.nombre_estado AS estado,
	lo.fecha_email,
	lo.fecha_alta_oferta,
	lo.numero_oferta,
	lo.ref_cliente_asunto_email,
	CASE
		WHEN NULLIF(LTRIM(RTRIM(ISNULL(lo.nombre_emisor, ''))), '') IS NOT NULL
			AND NULLIF(LTRIM(RTRIM(ISNULL(lo.email_emisor, ''))), '') IS NOT NULL
			THEN CONCAT(LTRIM(RTRIM(lo.nombre_emisor)), ' <', LTRIM(RTRIM(lo.email_emisor)), '>')
		WHEN NULLIF(LTRIM(RTRIM(ISNULL(lo.email_emisor, ''))), '') IS NOT NULL
			THEN LTRIM(RTRIM(lo.email_emisor))
		ELSE NULLIF(LTRIM(RTRIM(ISNULL(lo.nombre_emisor, ''))), '')
	END AS emisor,
	lo.nombre_emisor,
	lo.email_emisor,
	c.nombre_cliente AS cliente,
	lo.observaciones_cliente AS observaciones_oferta,
	oi.id_interaccion,
	oi.tipo_interaccion,
	oi.fecha_interaccion,
	oi.fecha_limite,
	oi.observaciones AS observaciones_interaccion
FROM ofertas.ofertas lo
LEFT JOIN ofertas.oferta_interacciones oi
	ON lo.id_oferta = oi.id_oferta
LEFT JOIN ofertas.estados e
	ON lo.id_estado = e.id_estado
LEFT JOIN ofertas.clientes c
	ON lo.id_cliente = c.id_cliente;
GO

-- =========================================================================
-- 6. DISPARADORES (TRIGGERS) OPTIMIZADOS
-- =========================================================================

CREATE OR ALTER TRIGGER [ofertas].[tr_ofertas_autogenerar_numerooferta]
ON [ofertas].[ofertas]
AFTER INSERT
AS
BEGIN
	IF TRIGGER_NESTLEVEL() > 1 RETURN;

	SET NOCOUNT ON;

	DECLARE @anio CHAR(4) = CONVERT(CHAR(4), YEAR(GETDATE()));
	DECLARE @UltimoCorrelativo INT = 0;

	-- Búsqueda directa sumamente veloz indexable (sin RIGHT() en el WHERE)
	SELECT @UltimoCorrelativo = ISNULL(MAX(TRY_CONVERT(INT, SUBSTRING(numero_oferta, 5, 5))), 0)
	FROM ofertas.ofertas WITH (UPDLOCK, HOLDLOCK)
	WHERE numero_oferta LIKE @anio + '%';

	;WITH pendientes AS (
		SELECT i.id_oferta,
			ROW_NUMBER() OVER (ORDER BY i.id_oferta) AS ordencorrelativo
		FROM inserted i
		WHERE ISNULL(i.numero_oferta, '') = ''
	), numerados AS (
		SELECT p.id_oferta,
			CONCAT(@anio, RIGHT('00000' + CAST((@UltimoCorrelativo + p.ordencorrelativo) AS VARCHAR(5)), 5)) AS numerooferta
		FROM pendientes p
	)
	UPDATE o
	SET o.numero_oferta = n.numerooferta,
		o.id_estado = 1
	FROM ofertas.ofertas o
	INNER JOIN numerados n
		ON o.id_oferta = n.id_oferta;
END;
GO