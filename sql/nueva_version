-- =========================================================================
-- 3. TABLA MAESTRA UNIFICADA DE OFERTAS
-- =========================================================================

CREATE TABLE [ofertas].[ofertas](
	[id_oferta] [int] IDENTITY(1,1) NOT NULL,
	[numero_oferta] [nvarchar](50) NULL,
	[id_estado] [int] NOT NULL CONSTRAINT [df_ofertas_id_estado] DEFAULT ((1)),
	[id_cliente] [int] NULL,
	[id_proyecto] [int] NULL,
	[id_departamento_destino] [int] NULL,
	[num_operario_responsable] [int] NULL,
	
	-- Datos del Origen (Email / Cliente)
	[fecha_email] [date] NULL,
	[fecha_alta_oferta] [date] NULL,
	[ref_cliente_asunto_email] [nvarchar](500) NULL,
	[nombre_emisor] [nvarchar](255) NULL,
	[email_emisor] [nvarchar](255) NULL,
	
	-- Fechas de Seguimiento Técnico (Fase ETC)
	[fecha_recepcion] [date] NULL,
	[fecha_envio_oferta] [date] NULL,
	[fecha_limite_respuesta] [date] NULL,
	
	-- Códigos y Referencias
	[codigo_externo_oferta] [nvarchar](100) NULL,
	[codigo_interno_oferta] [nvarchar](100) NULL,
	[referencia_cliente] [nvarchar](255) NULL,
	[numero_comision] [nvarchar](100) NULL,
	[po_original] [nvarchar](100) NULL,
	[pedido_b2b] [nvarchar](100) NULL,
	[empresa_solicitante] [nvarchar](255) NULL,
	
	-- Atributos Comerciales
	[incoterm] [varchar](10) NULL,
	[moneda] [char](3) NOT NULL CONSTRAINT [df_ofertas_moneda] DEFAULT ('EUR'),
	[prioridad] [varchar](20) NOT NULL CONSTRAINT [df_ofertas_prioridad] DEFAULT ('NORMAL'),
	[es_urgente] [bit] NOT NULL CONSTRAINT [df_ofertas_es_urgente] DEFAULT ((0)),
	
	-- Resúmenes y Observaciones
	[resumen_material_solicitado] [nvarchar](max) NULL,
	[resumen_material_ofertado] [nvarchar](max) NULL,
	[observaciones_cliente] [nvarchar](max) NULL,
	[observaciones_tecnicas] [nvarchar](max) NULL,
	[observaciones_internas] [nvarchar](max) NULL,
	
	-- Totales Económicos
	[total_material_eur] [decimal](18, 2) NULL,
	[total_fee_eur] [decimal](18, 2) NULL,
	[total_oferta_eur] AS (CASE WHEN [total_material_eur] IS NULL AND [total_fee_eur] IS NULL THEN NULL ELSE isnull([total_material_eur],(0))+isnull([total_fee_eur],(0)) END) PERSISTED,
	
	-- Auditoría
	[origen_registro] [varchar](20) NOT NULL CONSTRAINT [df_ofertas_origen_registro] DEFAULT ('MANUAL'),
	[activo] [bit] NOT NULL CONSTRAINT [df_ofertas_activo] DEFAULT ((1)),
	[fecha_creacion] [datetime2](0) NOT NULL CONSTRAINT [df_ofertas_fecha_creacion] DEFAULT (sysdatetime()),
	[fecha_actualizacion] [datetime2](0) NOT NULL CONSTRAINT [df_ofertas_fecha_actualizacion] DEFAULT (sysdatetime()),

 CONSTRAINT [pk_ofertas] PRIMARY KEY CLUSTERED ([id_oferta] ASC),
 CONSTRAINT [fk_ofertas_estados] FOREIGN KEY ([id_estado]) REFERENCES [ofertas].[estados] ([id_estado]),
 CONSTRAINT [fk_ofertas_clientes] FOREIGN KEY ([id_cliente]) REFERENCES [ofertas].[clientes] ([id_cliente]),
 CONSTRAINT [fk_ofertas_proyectos] FOREIGN KEY ([id_proyecto]) REFERENCES [ofertas].[proyectos] ([id_proyecto]),
 CONSTRAINT [fk_ofertas_departamentos] FOREIGN KEY ([id_departamento_destino]) REFERENCES [ofertas].[departamentos] ([id_departamento]),
 CONSTRAINT [fk_ofertas_usuarios_config] FOREIGN KEY ([num_operario_responsable]) REFERENCES [dbo].[usuarios_app] ([num_operario]), -- Corregido: apunta a [dbo].[usuarios_app]
 
 -- Validaciones
 CONSTRAINT [ck_ofertas_email_emisor] CHECK ([email_emisor] IS NULL OR charindex('@',[email_emisor])>(1)),
 CONSTRAINT [ck_ofertas_fechas] CHECK ([fecha_envio_oferta] IS NULL OR [fecha_recepcion] IS NULL OR [fecha_envio_oferta]>=[fecha_recepcion]),
 CONSTRAINT [ck_ofertas_importes] CHECK (([total_material_eur] IS NULL OR [total_material_eur]>=(0)) AND ([total_fee_eur] IS NULL OR [total_fee_eur]>=(0))),
 CONSTRAINT [ck_ofertas_incoterm] CHECK ([incoterm] IS NULL OR len(ltrim(rtrim([incoterm])))>=(3) AND len(ltrim(rtrim([incoterm])))<=(10)),
 CONSTRAINT [ck_ofertas_moneda] CHECK (len([moneda])=(3) AND [moneda]=upper([moneda])),
 CONSTRAINT [ck_ofertas_prioridad] CHECK ([prioridad]='CRITICA' OR [prioridad]='ALTA' OR [prioridad]='NORMAL' OR [prioridad]='BAJA'),
 CONSTRAINT [ck_ofertas_origen_registro] CHECK ([origen_registro]='IMPORTACION' OR [origen_registro]='EXCEL' OR [origen_registro]='EMAIL' OR [origen_registro]='MANUAL')
) ON [PRIMARY] TEXTIMAGE_ON [PRIMARY]
GO

